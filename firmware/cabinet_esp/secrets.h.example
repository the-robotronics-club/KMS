// Copy to secrets.h and fill in. secrets.h is gitignored; config.h picks it up
// through __has_include and every value below overrides the default there.
//
// Only override what you actually change — an absent define keeps config.h's
// value.

#pragma once

// Cabinet uplink Wi-Fi. No 802.1X — plain association, WPA2-PSK or open.
#define STA_SSID        "your-upstream-ssid"
#define STA_PASSWORD    "your-upstream-password"

// Campus captive portal. Leave PORTAL_LOGIN at 0 for a network that works as
// soon as it associates — home Wi-Fi, a phone hotspot, a 4G MiFi.
//
// Only these three go here. The IIT Mandi portal's endpoints, form fields and
// TLS root are already correct defaults in config.h — captured off the live
// portal, not guessed.
//
// SECURITY. This credential lives in the ESP32's flash, and flash reads out over
// USB with `esptool.py read_flash` — no soldering, no exploit. Anyone who opens
// the cabinet or borrows the board recovers a working campus account, and if
// that account is SSO it is also mail and everything else behind it. Ask IT for
// a service account or an IoT MAC exemption first; if you use a personal
// credential anyway, treat it as compromised once the board leaves your hands
// and rotate it when the project ends.
#define PORTAL_LOGIN        1
#define PORTAL_USERNAME     "your-ldap-id"
#define PORTAL_PASSWORD     "your-ldap-password"

// Device row from Admin -> Devices
#define DEVICE_UUID     "11111111-2222-3333-4444-555555555555"

// HiveMQ Cloud cluster. Use a credential issued to the board, not the backend's.
#define MQTT_HOST       "xxxxx.s1.eu.hivemq.cloud"
#define MQTT_PORT       8883
#define MQTT_USERNAME   "kms-cabinet"
#define MQTT_PASSWORD   "your-broker-password"
#define MQTT_TLS        1

// AP password members type to join ESP-KMS-xxxxxx (WPA2, min 8 chars)
#define AP_PASSWORD     "kmsesp32"

// Rack calibration — trim once against the real hardware
#define SLOT_ANGLE_OFFSET 0
