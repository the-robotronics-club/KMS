# Copy to .env.local for local development. On Vercel these are set in
# Project Settings → Environment Variables instead.

# Server-side only — used by the /api/:path* rewrite in next.config.js. The
# production build fails outright if this is missing, because a bundle silently
# pointing at localhost 502s in production with nothing in the logs to explain it.
INTERNAL_API_URL=http://localhost:8000
COOKIE_SECURE=false

# Inlined into the browser bundle at build time. Only used to build the
# wss:// origin for /ws/keys, which cannot go through the /api rewrite.
# Leave empty locally to fall back to the current host.
NEXT_PUBLIC_API_URL=

# Demo credential autofill on the login page. Leave unset in production — any
# value here ends up in the public JavaScript bundle.
# NEXT_PUBLIC_DEMO_MODE=true
# NEXT_PUBLIC_DEMO_EMAIL=demo@iitmandi.ac.in
# NEXT_PUBLIC_DEMO_PASSWORD=Demo@1234
