# ── Application ──────────────────────────────────────────────────────────────
DEBUG=false
# Must include the exact frontend origin, scheme included. Credentialed CORS
# rejects "*", so a missing entry here fails every logged-in request.
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# ── Database (Neon PostgreSQL) ────────────────────────────────────────────────
# Neon's console hands you a `postgresql://` URL with `?sslmode=require`.
# asyncpg needs both changed: the driver prefix, and `ssl=require` — it does not
# understand libpq's `sslmode` and errors on the unknown keyword.
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/kms?ssl=require

# ── Redis (Upstash) ───────────────────────────────────────────────────────────
REDIS_URL=rediss://default:password@your-upstash-host.upstash.io:6380

# ── MQTT ──────────────────────────────────────────────────────────────────────
# Leave false for a web-only deploy. The listener retries every 5s forever when
# no broker answers, which buries real errors in the log. Flip to true once the
# enclosure hardware is online — no code change needed.
MQTT_ENABLED=false

# Works for HiveMQ Cloud (TLS-only on 8883, rejects anonymous connections) or
# the self-hosted broker in docker-compose.prod.yml (plaintext 1883, same
# credentials — docker compose builds its password file from this pair at boot).
# The same values go into the firmware's config.h.
MQTT_HOST=xxxxx.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USERNAME=kms-backend
MQTT_PASSWORD=
# Shared password for the kms-device role (every ESP32 enclosure, per
# firmware/kms_enclosure/config.h). The prod broker creates this user at boot.
MQTT_DEVICE_PASSWORD=
MQTT_TLS=true

# ── Email ─────────────────────────────────────────────────────────────────────
# `smtp` sends for real and needs working credentials below — without them
# aiosmtplib raises mid-request and the caller 500s even though the key
# dispensed fine. Use `console` to log instead of sending while email is
# still unconfigured.
EMAIL_PROVIDER=smtp
EMAIL_ADDRESS=your-email@gmail.com
EMAIL_APP_PASSWORD=your-app-password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# ── Auth timing ───────────────────────────────────────────────────────────────
SESSION_TTL_SECONDS=3600
COOKIE_SECURE=false
PROXIMITY_CODE_TTL_SECONDS=120
PROXIMITY_FLAG_TTL_SECONDS=300
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
TOTP_MAX_ATTEMPTS=5
TOTP_LOCKOUT_SECONDS=300

# Encrypts users.totp_secret at rest, so a database dump does not hand over
# everyone's second factor. Required — the app refuses to start without it.
# Generate your own; never reuse this placeholder:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep a backup. Lose this key and every enrolled user must re-enroll.
TOTP_ENCRYPTION_KEY=

# ── Notification schedule ─────────────────────────────────────────────────────
REMINDER_BEFORE_DUE_MINUTES=30
ESCALATION_AFTER_DUE_HOURS=2

# ── Possession window ─────────────────────────────────────────────────────────
DEFAULT_POSSESSION_HOURS=6
